digraph G { rankdir=TB; node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica", fontsize=10];
 n1 [label="1\nInicio toggleList(id)", shape=ellipse];
 n2 [label="2\ns = new Set(watchlistIds())  [L26]", shape=box];
 n3 [label="3\ns.has(id)  [L27]", shape=diamond];
 n4 [label="4\nawait removeFromWatchlist(id)\ns.delete(id)  [L27]", shape=box];
 n5 [label="5\nawait addToWatchlist(id)\ns.add(id)  [L28]", shape=box];
 n6 [label="6\nwatchlistIds.set(s)  [L29]", shape=box];
 n7 [label="7\nFin normal", shape=ellipse];
 n8 [label="8\nFin por excepcion\n(la promesa se rechaza)", shape=ellipse];
 n1->n2; n2->n3; n3->n4 [label="V"]; n3->n5 [label="F"]; n4->n6 [label="exito"]; n5->n6 [label="exito"]; n6->n7;
 n4->n8 [label="error de red"]; n5->n8 [label="error de red"]; }
